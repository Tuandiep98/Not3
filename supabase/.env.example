# Edge Function secrets — `supabase secrets set --env-file supabase/.env`
APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.tuandiep.not3
# Phase 2 — AI. Only the key is required: model names are discovered from GET /models.
DEEPSEEK_API_KEY=
# Optional: force one model for every task (e.g. deepseek-flash). Leave empty for auto.
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DAILY_LIMIT=30